// This file defines the shape of the database. Prisma reads it and
// generates a fully-typed client (the `prisma.person.findMany(...)` style
// API) so we get autocomplete and compile-time errors instead of writing
// raw SQL strings by hand.
//
// Workflow while learning this:
//   1. Edit this file.
//   2. Run `npx prisma migrate dev --name some_description_of_the_change`.
//      This creates a SQL migration file AND applies it to your Neon
//      database AND regenerates the client, all in one command.
//   3. Run `npx prisma studio` any time you want a spreadsheet-like GUI
//      to browse/edit the data in your browser — great for sanity checks.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// PERSON
// ---------------------------------------------------------------------
model Person {
  id        String   @id @default(cuid())

  // The "Key" you write in the spreadsheet (family-data-template.xlsx),
  // stored permanently. This is what lets scripts/import-from-excel.ts
  // be run again and again as you edit the spreadsheet: it looks up
  // people by sourceKey to decide "update this existing person" vs.
  // "this is a brand new row" — without it, every re-run would create
  // duplicate people. Optional because people created via
  // scripts/seed.ts (or added directly through the app someday) won't
  // have one.
  sourceKey String? @unique

  firstName String
  // Optional: some people marrying into the family may only be known
  // by a first name (common for older, less-documented marriages).
  // Everywhere this is displayed, use the fullName() helper in
  // lib/formatName.ts rather than writing `${firstName} ${lastName}`
  // directly — it handles the missing-lastName case consistently.
  lastName  String?

  username     String  @unique
  passwordHash String

  mustChangePassword Boolean @default(true)

  gender Gender?

  birthDate DateTime?
  deathDate DateTime?
  bio       String?   @db.Text
  photoUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentOf Parentage[] @relation("ParentEdges")
  childOf  Parentage[] @relation("ChildEdges")

  marriagesAsPartnerA Marriage[] @relation("PartnerA")
  marriagesAsPartnerB Marriage[] @relation("PartnerB")

  timelineEvents TimelineEvent[]
}

model Parentage {
  id String @id @default(cuid())

  parent   Person @relation("ParentEdges", fields: [parentId], references: [id])
  parentId String

  child   Person @relation("ChildEdges", fields: [childId], references: [id])
  childId String

  @@unique([parentId, childId])
}

model Marriage {
  id String @id @default(cuid())

  partnerA   Person @relation("PartnerA", fields: [partnerAId], references: [id])
  partnerAId String

  partnerB   Person @relation("PartnerB", fields: [partnerBId], references: [id])
  partnerBId String

  startDate DateTime?
  endDate   DateTime?

  @@unique([partnerAId, partnerBId])
}

model TimelineEvent {
  id          String   @id @default(cuid())

  // Same idea as Person.sourceKey above — the "Key" column on the
  // Timeline sheet of family-data-template.xlsx, stored permanently so
  // re-running the import updates this exact event instead of creating
  // a duplicate every time.
  sourceKey   String?  @unique

  title       String
  description String   @db.Text
  eventDate   DateTime
  era         Era      @default(MODERN)
  imageUrl    String?
  sortOrder   Int      @default(0)

  person   Person? @relation(fields: [personId], references: [id])
  personId String?
}

enum Era {
  OLDER
  MODERN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}