# Copy this file to ".env" and fill in real values. ".env" is git-ignored
# on purpose — it holds secrets and must never be committed.

# --- Database (Neon) ---
# Get this from your Neon project dashboard: Connection Details ->
# "Prisma" tab gives you the exact string in this shape already.
# It must include "?sslmode=require" — Neon requires TLS.
DATABASE_URL=""postgresql://neondb_owner:npg_HbJ5gzPEBM8G@ep-withered-art-b5x8wxd4-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require""

# --- NextAuth ---
# A random secret NextAuth uses to sign/encrypt session tokens.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="LsC1tdd/C1nIQI1247zmLSXtMrgvaNPhrezOPOvXTms="

# The canonical URL of the app. Locally this is your dev server;
# in production, set it to your real Vercel URL (NextAuth uses this
# to build correct redirect/callback URLs).
NEXTAUTH_URL="https://clan-tree.vercel.app/"

# --- Vercel Blob (profile photo storage) ---
# Created automatically when you add a Blob store to your Vercel
# project; copy it from Project Settings -> Storage -> your Blob store.
BLOB_READ_WRITE_TOKEN="replace-with-vercel-blob-token"
